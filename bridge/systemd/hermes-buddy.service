[Unit]
Description=Hermes Buddy Bridge (ESP32 /state + /buddy/ask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/hermes-buddy/env
ExecStart=/usr/bin/python3 /opt/buddy/buddy_bridge.py
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
