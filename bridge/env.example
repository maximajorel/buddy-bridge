# Copiar a /etc/hermes-buddy/env y completar. NO commitear el archivo real.
# permisos recomendados: chown root:root, chmod 600

# URL del API server de Hermes (el gateway, no el dashboard).
HERMES_URL=http://127.0.0.1:8642

# Bearer del API server de Hermes. Se genera en /DATA_DIR/.env, 64 hex.
# NUNCA va al firmware: solo el bridge la usa.
API_SERVER_KEY=

# Token corto que usa la placa en el header X-Buddy-Token.
# Generá uno con: openssl rand -hex 24
BUDDY_TOKEN=

# Sesión fija que usa POST /buddy/ask (aislada del Desktop).
BUDDY_SESSION=esp32-buddy

# Dónde escucha el bridge.
BUDDY_BIND=0.0.0.0
BUDDY_PORT=8787

# Ruta al state DB del perfil default de Hermes.
BUDDY_STATE_DB=/DATA_DIR/state.db

# --- tiempos (segundos) ---
BUDDY_POLL_SECONDS=1        # cada cuánto relee la DB el thread global
BUDDY_TURN_GRACE=2.5        # margen tras un 'assistant' antes de declarar fin de turno
BUDDY_TOOL_WINDOW=12        # ventana para considerar una tool "en curso"
BUDDY_DONE_TTL=8            # cuánto dura 'done' antes de caer a idle
BUDDY_BORED_AFTER=180       # tras cuánto idle sin actividad pasa a 'bored'
