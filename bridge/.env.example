# Configuración del bridge ESP32 <-> Hermes.
#
# Copiar a `bridge/.env` (o al que diga HERMES_BUDDY_ENV_FILE) y completar.
# Precedencia: variable de entorno del sistema > este archivo > default del código.
# Esa precedencia existe para que un `.env` viejo no tape lo que systemd ya cargó.
#
# Los valores NO se suben al repo: `.env` está en .gitignore.

# --- API server de Hermes ----------------------------------------------------
# Donde escucha `hermes api-server`. El bridge solo habla con este puerto.
HERMES_URL=http://127.0.0.1:8642
# Bearer del API server. Sin esto /buddy/ask falla con 401.
API_SERVER_KEY=

# --- Cara que se dibuja en la placa ------------------------------------------
# Token de LECTURA (/state, /events). Vacío = sin auth (aceptable solo en LAN).
# Generarlo con: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
BUDDY_TOKEN=
# Token de ESCRITURA (/buddy/ask). Vacío = ask deshabilitado (403).
# Debe ser distinto de BUDDY_TOKEN: leer la cara no es poder mandar prompts.
BUDDY_ASK_TOKEN=
# Sesión de Hermes que recibe los asks. Una sola, fija, para que la placa
# siempre caiga en la misma conversación.
BUDDY_SESSION=esp32-buddy

# --- Red --------------------------------------------------------------------
BUDDY_BIND=0.0.0.0
BUDDY_PORT=8787

# --- Fuentes de verdad ------------------------------------------------------
# state.db de Hermes (solo lectura). Default: $HERMES_HOME/state.db
# BUDDY_STATE_DB=/opt/data/state.db

# --- Ritmos (segundos) ------------------------------------------------------
BUDDY_POLL_SECONDS=0.4
# Ventana en la que una tool sin responder cuenta como "en curso".
BUDDY_TOOL_WINDOW=12
# Gracia tras un mensaje del assistant antes de dar el turno por terminado.
BUDDY_TURN_GRACE=2.5
# Cuánto queda la cara "listo" antes de volver a standby.
BUDDY_DONE_TTL=8
# Long-poll máximo de /events.
BUDDY_EVENTS_WAIT_MAX=25
BUDDY_EVENTS_BUFFER=64
